#!/usr/sbin/nft -f

# Ensure the tables exist before flushing them so the first import succeeds.
# Flushing removes rules and chains left by an earlier configuration.
table ip nat
flush table ip nat

table ip nat {
	chain postrouting {
		type nat hook postrouting priority 100;

{% for rule in nftables_nat_rules.postrouting | default([]) %}
		{{ rule }}
{% endfor %}
	}
}

table ip6 nat
flush table ip6 nat

table ip6 nat {
	chain prerouting {
		type nat hook prerouting priority 100;

{% for rule in nftables_nat_ip6_rules.prerouting | default([]) %}
		{{ rule }}
{% endfor %}
	}
	chain postrouting {
		type nat hook postrouting priority 100;

{% for rule in nftables_nat_ip6_rules.postrouting | default([]) %}
		{{ rule }}
{% endfor %}
	}
}
