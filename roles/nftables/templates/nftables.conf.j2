#!/usr/sbin/nft -f

# Ensure the table exists before flushing it so the first import succeeds.
# Flushing removes rules and chains left by an earlier configuration.
table inet filter
flush table inet filter

table inet filter {
	chain input {
		type filter hook input priority filter;
		policy {{ nftables_config.input.policy }};

{% for preset_name in nftables_config.input.presets %}
		# preset: {{ preset_name }}
{% for rule in nftables_presets[preset_name] %}
		{{ rule }}
{% endfor %}
{% endfor %}
{% if nftables_config.input.rules %}
		# host rules
{% for rule in nftables_config.input.rules %}
		{{ rule }}
{% endfor %}
{% endif %}
	}
	chain forward {
		type filter hook forward priority filter;
	}
	chain output {
		type filter hook output priority filter;
	}
}

include "/etc/nftables.d/tables/*"
